# ==============================================================================
# LIFEOS AI — ENVIRONMENT CONFIGURATION
# Copy this file to .env and insert your real keys
# ==============================================================================

# Supabase Database & Auth (Get from https://supabase.com -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# AI Engine Configuration (Choose 'gemini' or 'groq')
VITE_AI_PROVIDER=gemini

# Google Gemini API Key (Get free key from https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Groq Cloud API Key (Get free key from https://console.groq.com/keys)
VITE_GROQ_API_KEY=your-groq-api-key-here
